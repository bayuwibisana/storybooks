<script is:inline define:vars={{ storyData: story, pagesData: pages, isLocked, showAudio: showAudioPlayer }}>
  // Story Navigation Drawer Logic (Active for both locked and unlocked views)
  const openDrawerBtns = document.querySelectorAll('.open-drawer-btn, #floating-drawer-btn');
  const closeDrawerBtn = document.getElementById('close-drawer-btn');
  const drawerBackdrop = document.getElementById('drawer-backdrop');
  const storyDrawer = document.getElementById('story-drawer');
  const drawerSearchInput = document.getElementById('drawer-search-input');
  const drawerStoryItems = document.querySelectorAll('.drawer-story-item');

  function openStoryDrawer() {
    if (storyDrawer && drawerBackdrop) {
      storyDrawer.style.display = 'flex';
      // Lazy load drawer thumbnails only when the drawer is actually opened!
      const lazyThumbs = storyDrawer.querySelectorAll('.drawer-thumb[data-src]');
      lazyThumbs.forEach((img) => {
        const ds = img.getAttribute('data-src');
        if (ds) {
          img.setAttribute('src', ds);
          img.removeAttribute('data-src');
        }
      });
      requestAnimationFrame(() => {
        storyDrawer.classList.add('open');
        drawerBackdrop.classList.add('open');
      });
      document.body.style.overflow = 'hidden';
      // Auto-scroll current story into view
      const currentItem = document.querySelector('.drawer-story-item.is-current');
      if (currentItem) {
        currentItem.scrollIntoView({ block: 'center', behavior: 'smooth' });
      }
      if (drawerSearchInput) {
        setTimeout(() => drawerSearchInput.focus(), 250);
      }
    }
  }

  function closeStoryDrawer() {
    if (storyDrawer && drawerBackdrop) {
      storyDrawer.classList.remove('open');
      drawerBackdrop.classList.remove('open');
      document.body.style.overflow = '';
      setTimeout(() => {
        if (!storyDrawer.classList.contains('open')) {
          storyDrawer.style.display = 'none';
        }
      }, 300);
    }
  }

  openDrawerBtns.forEach((btn) => btn.addEventListener('click', openStoryDrawer));
  if (closeDrawerBtn) closeDrawerBtn.addEventListener('click', closeStoryDrawer);
  if (drawerBackdrop) drawerBackdrop.addEventListener('click', closeStoryDrawer);

  // Search filter
  if (drawerSearchInput) {
    drawerSearchInput.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      drawerStoryItems.forEach((item) => {
        const title = (item.getAttribute('data-title') || '').toLowerCase();
        const num = item.getAttribute('data-number') || '';
        if (!q || title.includes(q) || num.includes(q)) {
          item.style.display = 'flex';
        } else {
          item.style.display = 'none';
        }
      });
    });
  }

  // Keyboard shortcut: Escape closes drawer
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && storyDrawer && storyDrawer.classList.contains('open')) {
      closeStoryDrawer();
    }
  });

  if (!isLocked) {
    let currentStep = 0; // 0 = Cover, 1..10 = Pages
    let currentLang = 'id'; // 'id' | 'en'
    try {
      const savedLang = localStorage.getItem('kisah_reader_lang');
      if (savedLang === 'en' || savedLang === 'id') {
        currentLang = savedLang;
      }
    } catch (e) {}

    let isLargeFont = false;
    try {
      isLargeFont = localStorage.getItem('kisah_reader_font') === 'large';
    } catch (e) {}
    // Audio narration state
    let currentAudio = null;
    let isAudioPlaying = false;

    const totalSteps = pagesData.length;

    let imageLoadSeq = 0;

    let preloadTimer = null;
    function preloadUpcomingPages(step) {
      if (preloadTimer) clearTimeout(preloadTimer);
      preloadTimer = setTimeout(() => {
        const targetStep = step + 1;
        if (targetStep > 0 && targetStep <= pagesData.length) {
          const targetPage = pagesData[targetStep - 1];
          if (targetPage && targetPage.image) {
            const img = new Image();
            img.src = `/${targetPage.image}`;
          }
        }
      }, step === 0 ? 1500 : 700);
    }

    const readerImage = document.getElementById('reader-image');
    const readerHeading = document.getElementById('reader-heading');
    const readerText = document.getElementById('reader-text');
    const readerQuote = document.getElementById('reader-quote');
    const readerCoReading = document.getElementById('reader-coreading');
    const pageBadge = document.getElementById('page-indicator-badge');
    const bottomLabel = document.getElementById('bottom-page-label');
    const progressIndicator = document.getElementById('progress-indicator');
    const langBtn = document.getElementById('lang-toggle-btn');
    const fontBtn = document.getElementById('font-toggle-btn');
    const paddlePrev = document.getElementById('paddle-prev');
    const paddleNext = document.getElementById('paddle-next');
    const bottomPrev = document.getElementById('bottom-prev');
    const bottomNext = document.getElementById('bottom-next');
    const finishModal = document.getElementById('finish-modal');
    const modalReplay = document.getElementById('modal-replay-btn');
    const readerRoot = document.getElementById('reader-root');
    const beads = document.querySelectorAll('.step-bead');

    // Audio elements
    const audioPlayBtn = document.getElementById('audio-play-btn');
    const audioPlayIcon = document.getElementById('audio-play-icon');
    const audioPlayText = document.getElementById('audio-play-text');
    const audioStopBtn = document.getElementById('audio-stop-btn');
    const audioStatusText = document.getElementById('audio-status-text');
    const audioTopBtn = document.getElementById('audio-top-btn');
    const audioTopIcon = document.getElementById('audio-top-icon');
    const audioTopLabel = document.getElementById('audio-top-label');

    // Auto-turn state
    let isAutoTurn = true;
    let autoTurnTimer = null;
    const autoTurnBtn = document.getElementById('auto-turn-toggle-btn');
    const autoTurnText = document.getElementById('auto-turn-toggle-text');

    if (autoTurnBtn) {
      autoTurnBtn.addEventListener('click', () => {
        isAutoTurn = !isAutoTurn;
        if (isAutoTurn) {
          autoTurnBtn.classList.add('is-active');
          autoTurnBtn.setAttribute('aria-pressed', 'true');
          if (autoTurnText) autoTurnText.textContent = 'Balik Otomatis';
        } else {
          autoTurnBtn.classList.remove('is-active');
          autoTurnBtn.setAttribute('aria-pressed', 'false');
          if (autoTurnText) autoTurnText.textContent = 'Balik Manual';
          if (autoTurnTimer) {
            clearTimeout(autoTurnTimer);
            autoTurnTimer = null;
          }
        }
      });
    }

    function stopAudio() {
      if (autoTurnTimer) {
        clearTimeout(autoTurnTimer);
        autoTurnTimer = null;
      }
      if (currentAudio) {
        currentAudio.pause();
        currentAudio.currentTime = 0;
        currentAudio.onended = null;
        currentAudio = null;
      }
      isAudioPlaying = false;
      if (audioPlayBtn) {
        audioPlayIcon.textContent = '▶';
        audioPlayText.textContent = 'Putar Cerita';
        audioPlayBtn.style.background = '#e5a823';
        audioPlayBtn.style.color = '#242220';
      }
      if (audioTopBtn) {
        if (audioTopIcon) audioTopIcon.textContent = '🔊';
        if (audioTopLabel) audioTopLabel.textContent = 'Audio';
        audioTopBtn.style.background = '#fff8eb';
        audioTopBtn.style.color = '#78350f';
        audioTopBtn.style.borderColor = '#fed7aa';
      }
      if (audioStatusText) {
        const isCover = currentStep === 0;
        const pageLabel = isCover ? 'Sampul' : `Halaman ${currentStep}`;
        audioStatusText.textContent = `Narasi Siap: ${pageLabel} (Despina)`;
      }
    }

    function playAudio(fromAutoTurn = false) {
      if (autoTurnTimer) {
        clearTimeout(autoTurnTimer);
        autoTurnTimer = null;
      }
      stopAudio();

      const isCover = currentStep === 0;
      let audioPath = '';
      if (isCover) {
        audioPath = `/audio/story${storyData.storyNumber}/page_0_cover.m4a`;
      } else {
        const p = pagesData[currentStep - 1];
        audioPath = p && p.audio ? `/${p.audio.replace(/\.wav$/i, '.m4a')}` : `/audio/story${storyData.storyNumber}/page_${currentStep}.m4a`;
      }

      const audio = new Audio(audioPath);
      currentAudio = audio;
      window.__currentAudio = audio;

      audio.play().then(() => {
        isAudioPlaying = true;
        if (audioPlayIcon) audioPlayIcon.textContent = '⏸';
        if (audioPlayText) audioPlayText.textContent = 'Jeda';
        if (audioPlayBtn) {
          audioPlayBtn.style.background = '#2f5243';
          audioPlayBtn.style.color = '#fff';
        }
        if (audioTopBtn) {
          if (audioTopIcon) audioTopIcon.textContent = '⏸';
          if (audioTopLabel) audioTopLabel.textContent = 'Jeda';
          audioTopBtn.style.background = '#2f5243';
          audioTopBtn.style.color = '#fff';
        }
        if (audioStatusText) {
          const pageLabel = isCover ? 'Sampul Buku' : `Halaman ${currentStep}`;
          audioStatusText.textContent = `Memutar: ${pageLabel} • Despina`;
        }
      }).catch((err) => {
        console.warn('Audio play error:', err);
        stopAudio();
        if (audioStatusText) audioStatusText.textContent = 'File narasi belum tersedia';
      });

      audio.onended = () => {
        stopAudio();
        if (isAutoTurn) {
          if (currentStep < totalSteps) {
            const nextLabel = currentStep === 0 ? 'Halaman 1' : `Halaman ${currentStep + 1}`;
            if (audioStatusText) {
              audioStatusText.textContent = `Selesai. Membalik ke ${nextLabel}...`;
            }
            autoTurnTimer = setTimeout(() => {
              autoTurnTimer = null;
              goToStep(currentStep + 1, /* shouldPlayAudio = */ true);
            }, 850);
          } else {
            // Final page 10 finished!
            if (audioStatusText) {
              audioStatusText.textContent = `Cerita selesai! Selamat tidur...`;
            }
            autoTurnTimer = setTimeout(() => {
              autoTurnTimer = null;
              goToStep(totalSteps + 1);
            }, 1000);
          }
        }
      };
    }

    function toggleAudio() {
      if (isAudioPlaying && currentAudio) {
        currentAudio.pause();
        isAudioPlaying = false;
        if (audioPlayIcon) audioPlayIcon.textContent = '▶';
        if (audioPlayText) audioPlayText.textContent = 'Lanjut';
        if (audioTopBtn) {
          if (audioTopIcon) audioTopIcon.textContent = '▶';
          if (audioTopLabel) audioTopLabel.textContent = 'Lanjut';
          audioTopBtn.style.background = '#fff8eb';
          audioTopBtn.style.color = '#78350f';
        }
        if (audioStatusText) audioStatusText.textContent = 'Narasi Suara Dijeda';
        return;
      }

      if (currentAudio && currentAudio.paused) {
        currentAudio.play().then(() => {
          isAudioPlaying = true;
          if (audioPlayIcon) audioPlayIcon.textContent = '⏸';
          if (audioPlayText) audioPlayText.textContent = 'Jeda';
          if (audioTopBtn) {
            if (audioTopIcon) audioTopIcon.textContent = '⏸';
            if (audioTopLabel) audioTopLabel.textContent = 'Jeda';
            audioTopBtn.style.background = '#2f5243';
            audioTopBtn.style.color = '#fff';
          }
          if (audioStatusText) audioStatusText.textContent = 'Memutar Narasi Suara...';
        }).catch(err => console.warn(err));
        return;
      }

      playAudio();
    }

    if (audioPlayBtn) {
      audioPlayBtn.addEventListener('click', toggleAudio);
    }
    if (audioTopBtn) {
      audioTopBtn.addEventListener('click', toggleAudio);
    }
    if (audioStopBtn) {
      audioStopBtn.addEventListener('click', stopAudio);
    }

    function updateReader() {
      const isCover = currentStep === 0;
      const currentPage = isCover ? null : pagesData[currentStep - 1];

      // Progress bar
      const pct = isCover ? 0 : Math.round((currentStep / totalSteps) * 100);
      progressIndicator.style.width = pct + '%';

      // Image with loading indicator and cache check
      const imgPath = isCover ? `/${storyData.coverImage}` : `/${currentPage.image}`;
      const imageLoader = document.getElementById('image-loader');
      const seq = ++imageLoadSeq;

      const testImg = new Image();
      testImg.src = imgPath;

      if (testImg.complete && testImg.naturalWidth > 0) {
        // Already cached in browser! Instant seamless swap
        if (imageLoader) {
          imageLoader.classList.add('is-hidden');
        }
        readerImage.src = imgPath;
        readerImage.classList.remove('is-loading');
        preloadUpcomingPages(currentStep);
      } else {
        // Not yet loaded: show cozy skeleton shimmer and fade out previous image
        if (imageLoader) {
          imageLoader.classList.remove('is-hidden');
        }
        readerImage.classList.add('is-loading');

        testImg.onload = () => {
          if (seq !== imageLoadSeq) return; // Prevent race conditions on fast clicking
          readerImage.src = imgPath;
          readerImage.classList.remove('is-loading');
          if (imageLoader) {
            imageLoader.classList.add('is-hidden');
          }
          preloadUpcomingPages(currentStep);
        };

        testImg.onerror = () => {
          if (seq !== imageLoadSeq) return;
          readerImage.src = imgPath;
          readerImage.classList.remove('is-loading');
          if (imageLoader) {
            imageLoader.classList.add('is-hidden');
          }
        };
      }

      // Badge & Labels
      const badgeText = isCover
        ? (currentLang === 'en' ? 'Book Cover' : 'Sampul Buku')
        : (currentLang === 'en' ? `Page ${currentStep} of ${totalSteps}` : `Halaman ${currentStep} dari ${totalSteps}`);
      pageBadge.textContent = badgeText;
      bottomLabel.textContent = badgeText;

      // Heading & Narrative
      if (isCover) {
        readerHeading.textContent = (currentLang === 'en' && storyData.titleEn) ? storyData.titleEn : storyData.title;
        readerText.textContent = (currentLang === 'en' && storyData.synopsisEn) ? storyData.synopsisEn : storyData.synopsis;
        readerQuote.textContent = currentLang === 'en'
          ? `🐾 Characters: ${storyData.protagonist} ${storyData.companion ? '& ' + storyData.companion : ''}`
          : `🐾 Tokoh: ${storyData.protagonist} ${storyData.companion ? '& ' + storyData.companion : ''}`;
        readerCoReading.innerHTML = currentLang === 'en'
          ? `💡 <strong>Reading Tips:</strong> Read with a gentle, soothing tone. Invite your child to look at the crayon artwork before bedtime.`
          : `💡 <strong>Tips Membaca:</strong> Baca dengan nada tenang dan hangat, ajak si kecil menunjuk detail pada ilustrasi krayon sebelum tidur.`;
      } else {
        const title = (currentLang === 'en' && currentPage.titleEn)
          ? currentPage.titleEn
          : (currentPage.title || (currentLang === 'en' ? `Page ${currentStep}` : `Halaman ${currentStep}`));
        readerHeading.textContent = title;

        const body = (currentLang === 'en' && currentPage.textEn) ? currentPage.textEn : currentPage.textId;
        readerText.textContent = body;

        readerQuote.textContent = currentPage.quote || `🌟 Halaman ${currentStep}`;
        readerCoReading.innerHTML = currentPage.coReading
          ? `💡 <strong>Co-Reading:</strong> ${currentPage.coReading}`
          : `💡 <strong>Tips:</strong> Ajak anak bercerita tentang gambar ini.`;
      }

      // Paddle button states
      paddlePrev.style.opacity = isCover ? '0.3' : '1';
      paddlePrev.style.pointerEvents = isCover ? 'none' : 'auto';
      bottomPrev.disabled = isCover;

      // Active bead
      beads.forEach((b) => {
        const step = parseInt(b.getAttribute('data-step') || '0', 10);
        if (step === currentStep) {
          b.classList.add('active');
          b.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else {
          b.classList.remove('active');
        }
      });

      // Audio narration indicator per page
      if (showAudio) {
        const audioEnNote = document.getElementById('audio-en-note');
        if (currentLang === 'en') {
          if (audioEnNote) audioEnNote.style.display = 'block';
        } else {
          if (audioEnNote) audioEnNote.style.display = 'none';
        }

        const p = isCover ? null : pagesData[currentStep - 1];
        const pageHasAudio = isCover ? true : Boolean(p && p.audio);
        if (audioPlayBtn) {
          audioPlayBtn.disabled = !pageHasAudio;
          audioPlayBtn.style.opacity = pageHasAudio ? '1' : '0.4';
          audioPlayBtn.style.cursor = pageHasAudio ? 'pointer' : 'not-allowed';
        }
        if (audioTopBtn) {
          audioTopBtn.disabled = !pageHasAudio;
          audioTopBtn.style.opacity = pageHasAudio ? '1' : '0.4';
          audioTopBtn.style.cursor = pageHasAudio ? 'pointer' : 'not-allowed';
        }
        if (audioStatusText && !isAudioPlaying) {
          const pageLabel = isCover ? 'Sampul' : `Halaman ${currentStep}`;
          if (currentLang === 'en') {
            audioStatusText.textContent = pageHasAudio
              ? `Audio ID: ${pageLabel} (EN segera hadir)`
              : `Narasi ${pageLabel} belum tersedia`;
          } else {
            audioStatusText.textContent = pageHasAudio
              ? `Narasi Siap: ${pageLabel} (Despina)`
              : `Narasi ${pageLabel} belum tersedia`;
          }
        }
      }
    }

    function goToStep(step, shouldPlayAudio = false) {
      if (step < 0) return;
      if (step > totalSteps) {
        stopAudio();
        // Show celebration
        finishModal.style.display = 'flex';
        return;
      }
      stopAudio();
      currentStep = step;
      updateReader();
      window.scrollTo({ top: 120, behavior: 'smooth' });

      if (shouldPlayAudio) {
        setTimeout(() => {
          playAudio(/* fromAutoTurn = */ true);
        }, 300);
      }
    }

    paddlePrev.addEventListener('click', () => goToStep(currentStep - 1));
    bottomPrev.addEventListener('click', () => goToStep(currentStep - 1));

    paddleNext.addEventListener('click', () => goToStep(currentStep + 1));
    bottomNext.addEventListener('click', () => goToStep(currentStep + 1));

    beads.forEach((b) => {
      b.addEventListener('click', () => {
        const step = parseInt(b.getAttribute('data-step') || '0', 10);
        goToStep(step);
      });
    });

    if (langBtn) {
      langBtn.textContent = currentLang.toUpperCase();
    }
    const langBtnLand = document.getElementById('lang-toggle-btn-land');
    if (langBtnLand) {
      langBtnLand.textContent = currentLang.toUpperCase();
    }

    if (isLargeFont && readerRoot && fontBtn) {
      readerRoot.classList.add('large-font');
      fontBtn.style.background = '#c85a32';
      fontBtn.style.color = '#fff';
    }

    function toggleLanguage() {
      stopAudio();
      currentLang = currentLang === 'id' ? 'en' : 'id';
      try { localStorage.setItem('kisah_reader_lang', currentLang); } catch (e) {}
      if (langBtn) langBtn.textContent = currentLang.toUpperCase();
      if (langBtnLand) langBtnLand.textContent = currentLang.toUpperCase();
      updateReader();
    }

    if (langBtn) langBtn.addEventListener('click', toggleLanguage);
    if (langBtnLand) langBtnLand.addEventListener('click', toggleLanguage);

    fontBtn.addEventListener('click', () => {
      isLargeFont = !isLargeFont;
      try { localStorage.setItem('kisah_reader_font', isLargeFont ? 'large' : 'normal'); } catch (e) {}
      if (isLargeFont) {
        readerRoot.classList.add('large-font');
        fontBtn.style.background = '#c85a32';
        fontBtn.style.color = '#fff';
      } else {
        readerRoot.classList.remove('large-font');
        fontBtn.style.background = '#faf8f5';
        fontBtn.style.color = 'var(--ink)';
      }
    });

    // Sleep Timer (15m / 30m / Off)
    const sleepTimerBtn = document.getElementById('sleep-timer-btn');
    const sleepTimerIcon = document.getElementById('sleep-timer-icon');
    const sleepTimerText = document.getElementById('sleep-timer-text');
    let sleepTimerMinutes = 0;
    let sleepTimerSecondsLeft = 0;
    let sleepTimerInterval = null;

    function updateSleepTimerUI() {
      if (!sleepTimerBtn) return;
      if (sleepTimerSecondsLeft > 0) {
        sleepTimerBtn.classList.add('active');
        sleepTimerBtn.style.width = 'auto';
        sleepTimerBtn.style.padding = '0 0.5rem';
        if (sleepTimerText) {
          sleepTimerText.style.display = 'inline';
          const mins = Math.floor(sleepTimerSecondsLeft / 60);
          const secs = sleepTimerSecondsLeft % 60;
          sleepTimerText.textContent = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
        }
      } else {
        sleepTimerBtn.classList.remove('active');
        sleepTimerBtn.style.width = '2rem';
        sleepTimerBtn.style.padding = '0';
        if (sleepTimerText) {
          sleepTimerText.style.display = 'none';
          sleepTimerText.textContent = '';
        }
      }
    }

    function onSleepTimerEnd() {
      if (sleepTimerInterval) {
        clearInterval(sleepTimerInterval);
        sleepTimerInterval = null;
      }
      sleepTimerMinutes = 0;
      sleepTimerSecondsLeft = 0;
      updateSleepTimerUI();

      // Disable auto-turn so pages stop flipping
      isAutoTurn = false;
      if (autoTurnBtn) {
        autoTurnBtn.classList.remove('is-active');
        autoTurnBtn.setAttribute('aria-pressed', 'false');
      }

      // Smooth audio fade out over 2.5 seconds
      if (currentAudio && !currentAudio.paused) {
        let vol = 1.0;
        const fade = setInterval(() => {
          vol -= 0.15;
          if (vol <= 0.05) {
            clearInterval(fade);
            stopAudio();
            if (currentAudio) currentAudio.volume = 1.0;
          } else if (currentAudio) {
            currentAudio.volume = Math.max(0, vol);
          }
        }, 250);
      } else {
        stopAudio();
      }

      // Automatically engage Bedtime Dim Mode if not already active
      applyBedtimeDim(true);

      if (audioStatusText) {
        audioStatusText.textContent = 'Timer selesai. Selamat tidur nyenyak 🌙';
      }
    }

    function toggleSleepTimer() {
      if (sleepTimerMinutes === 0) {
        sleepTimerMinutes = 15;
      } else if (sleepTimerMinutes === 15) {
        sleepTimerMinutes = 30;
      } else {
        sleepTimerMinutes = 0;
      }

      if (sleepTimerInterval) {
        clearInterval(sleepTimerInterval);
        sleepTimerInterval = null;
      }

      if (sleepTimerMinutes > 0) {
        sleepTimerSecondsLeft = sleepTimerMinutes * 60;
        updateSleepTimerUI();
        sleepTimerInterval = setInterval(() => {
          sleepTimerSecondsLeft--;
          if (sleepTimerSecondsLeft <= 0) {
            onSleepTimerEnd();
          } else {
            updateSleepTimerUI();
          }
        }, 1000);
      } else {
        sleepTimerSecondsLeft = 0;
        updateSleepTimerUI();
      }
    }

    if (sleepTimerBtn) {
      sleepTimerBtn.addEventListener('click', toggleSleepTimer);
    }

    // Touch Swipe Gesture for Mobile & Tablet
    let touchStartX = 0;
    let touchStartY = 0;
    let touchEndX = 0;
    let touchEndY = 0;
    const swipeArea = document.getElementById('story-spread-article') || readerRoot;

    if (swipeArea) {
      swipeArea.addEventListener('touchstart', (e) => {
        if (!e.changedTouches || e.changedTouches.length === 0) return;
        touchStartX = e.changedTouches[0].screenX;
        touchStartY = e.changedTouches[0].screenY;
      }, { passive: true });

      swipeArea.addEventListener('touchend', (e) => {
        if (!e.changedTouches || e.changedTouches.length === 0) return;
        touchEndX = e.changedTouches[0].screenX;
        touchEndY = e.changedTouches[0].screenY;
        const deltaX = touchEndX - touchStartX;
        const deltaY = touchEndY - touchStartY;
        const minSwipeDistance = 45;

        // Ensure horizontal swipe is dominant (not vertical scrolling)
        if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) >= minSwipeDistance) {
          if (deltaX < 0) {
            // Swipe Left -> Next Page
            if (currentStep <= totalSteps) {
              goToStep(currentStep + 1);
            }
          } else {
            // Swipe Right -> Prev Page
            if (currentStep > 0) {
              goToStep(currentStep - 1);
            }
          }
        }
      }, { passive: true });
    }

    // Bedtime Dim Mode (Warm Amber / Dark Night Theme)
    const dimBtn = document.getElementById('dim-toggle-btn');
    const dimBtnLand = document.getElementById('dim-toggle-btn-land');
    const dimBtnIcon = document.getElementById('dim-btn-icon');
    let isBedtimeDim = false;
    try {
      isBedtimeDim = localStorage.getItem('kisah_bedtime_dim') === 'true';
    } catch (e) {}

    function applyBedtimeDim(isDim) {
      if (isDim) {
        document.body.classList.add('bedtime-dim');
        if (dimBtn) {
          dimBtn.style.background = '#d97706';
          dimBtn.style.color = '#fff';
          dimBtn.style.borderColor = '#d97706';
          dimBtn.title = 'Matikan Mode Redup';
        }
        if (dimBtnLand) {
          dimBtnLand.style.background = '#d97706';
          dimBtnLand.style.color = '#fff';
          dimBtnLand.style.borderColor = '#d97706';
          dimBtnLand.title = 'Matikan Mode Redup';
        }
        if (dimBtnIcon) dimBtnIcon.textContent = '☀️';
      } else {
        document.body.classList.remove('bedtime-dim');
        if (dimBtn) {
          dimBtn.style.background = '#faf8f5';
          dimBtn.style.color = 'var(--ink)';
          dimBtn.style.borderColor = 'var(--line)';
          dimBtn.title = 'Mode Redup Pengantar Tidur (Layar Hangat)';
        }
        if (dimBtnLand) {
          dimBtnLand.style.background = '#faf8f5';
          dimBtnLand.style.color = 'var(--ink)';
          dimBtnLand.style.borderColor = 'var(--line)';
          dimBtnLand.title = 'Mode Redup Pengantar Tidur (Layar Hangat)';
        }
        if (dimBtnIcon) dimBtnIcon.textContent = '🌙';
      }
    }

    applyBedtimeDim(isBedtimeDim);

    function toggleBedtimeDim() {
      isBedtimeDim = !isBedtimeDim;
      try {
        localStorage.setItem('kisah_bedtime_dim', isBedtimeDim ? 'true' : 'false');
      } catch (e) {}
      applyBedtimeDim(isBedtimeDim);
    }

    if (dimBtn) dimBtn.addEventListener('click', toggleBedtimeDim);
    if (dimBtnLand) dimBtnLand.addEventListener('click', toggleBedtimeDim);
    modalReplay.addEventListener('click', () => {
      finishModal.style.display = 'none';
      goToStep(0);
    });

    // Keyboard navigation
    window.addEventListener('keydown', (e) => {
      if (finishModal.style.display === 'flex') return;
      if (storyDrawer && storyDrawer.classList.contains('open')) return;
      if (e.key === 'ArrowRight' || e.key === 'PageDown') {
        goToStep(currentStep + 1);
      } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
        goToStep(currentStep - 1);
      }
    });

    // Initial render
    updateReader();
  }
</script>
