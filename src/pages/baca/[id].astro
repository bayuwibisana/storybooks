---
export const prerender = false;

import { and, asc, eq } from 'drizzle-orm';
import Layout from '../../layouts/Layout.astro';
import { db } from '../../db/client';
import { stories, storyPages } from '../../db/schema';
import { accessLevel, readableStoryIds } from '../../db/entitlements';
import { getViewer } from '../../lib/session';
import { getStoryUrl, slugifyTitle } from '../../lib/story-url';

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/');
}

const viewer = await getViewer(Astro);

const rawParam = String(id || '').trim().toLowerCase();
const numMatch = rawParam.match(/^(?:story|cerita)?[-_]?0*(\d+)$/i);

const storyFields = {
  id: stories.id,
  storyNumber: stories.storyNumber,
  title: stories.title,
  titleEn: stories.titleEn,
  category: stories.category,
  categoryLabel: stories.categoryLabel,
  ageGroup: stories.ageGroup,
  moralTheme: stories.moralTheme,
  synopsis: stories.synopsis,
  synopsisEn: stories.synopsisEn,
  protagonist: stories.protagonist,
  companion: stories.companion,
  setting: stories.setting,
  coverImage: stories.coverImage,
  isFree: stories.isFree,
};

let story: any = null;

// 1. Check numeric or story-N / cerita-N (e.g. "2", "story-2", "story-02", "cerita-2")
if (numMatch) {
  const storyNum = parseInt(numMatch[1], 10);
  const [s] = await db
    .select(storyFields)
    .from(stories)
    .where(and(eq(stories.storyNumber, storyNum), eq(stories.isPublished, true)))
    .limit(1);
  story = s || null;
}

// 2. Check exact id (e.g. "selimut-bulan", "barnaby-bear", "story-006-emosi")
if (!story) {
  const [s] = await db
    .select(storyFields)
    .from(stories)
    .where(and(eq(stories.id, rawParam), eq(stories.isPublished, true)))
    .limit(1);
  story = s || null;
}

// 3. Check slugified title (e.g. "gadis-yang-merajut-selimut-bulan", "2-gadis-yang-merajut-selimut-bulan")
if (!story) {
  const allPublished = await db
    .select(storyFields)
    .from(stories)
    .where(eq(stories.isPublished, true));

  story =
    allPublished.find((s) => {
      const slug = slugifyTitle(s.title);
      return slug === rawParam || `${s.storyNumber}-${slug}` === rawParam;
    }) || null;
}

if (!story) {
  return Astro.redirect('/404');
}

const access = accessLevel(story, viewer);
const isLocked = access === 'locked';

// Fetch all published stories and readable entitlements concurrently
const [allStories, readable] = await Promise.all([
  db
    .select({
      id: stories.id,
      storyNumber: stories.storyNumber,
      title: stories.title,
      titleEn: stories.titleEn,
      categoryLabel: stories.categoryLabel,
      coverImage: stories.coverImage,
      isFree: stories.isFree,
    })
    .from(stories)
    .where(eq(stories.isPublished, true))
    .orderBy(asc(stories.storyNumber)),
  readableStoryIds(db, viewer),
]);

// Feature Flag: Show audio in local dev (import.meta.env.DEV) or if PUBLIC_ENABLE_AUDIO=true is configured
const isAudioFeatureEnabled = import.meta.env.DEV || import.meta.env.PUBLIC_ENABLE_AUDIO === 'true';

// STRICT SECURITY: For locked stories, NEVER load or send page contents to the client!
let pages: Array<{
  number: number;
  title: string | null;
  titleEn: string | null;
  textId: string;
  textEn: string | null;
  quote: string | null;
  coReading: string | null;
  image: string;
  audio: string | null;
  audioEnabled: boolean;
}> = [];

let nextStory: { id: string; storyNumber: number; title: string } | null = null;
let showAudioPlayer = false;
let hasAudio = false;

if (!isLocked) {
  const [pagesResult, nextResult] = await Promise.all([
    db
      .select({
        number: storyPages.number,
        title: storyPages.title,
        titleEn: storyPages.titleEn,
        textId: storyPages.textId,
        textEn: storyPages.textEn,
        quote: storyPages.quote,
        coReading: storyPages.coReading,
        image: storyPages.image,
        audio: storyPages.audio,
        audioEnabled: storyPages.audioEnabled,
      })
      .from(storyPages)
      .where(eq(storyPages.storyId, story.id))
      .orderBy(asc(storyPages.number)),
    db
      .select({
        id: stories.id,
        storyNumber: stories.storyNumber,
        title: stories.title,
      })
      .from(stories)
      .where(and(eq(stories.isPublished, true), eq(stories.storyNumber, story.storyNumber + 1)))
      .limit(1),
  ]);

  pages = pagesResult;
  hasAudio = pages.some((p) => Boolean(p.audio)) || story.storyNumber <= 3;
  showAudioPlayer = isAudioFeatureEnabled && hasAudio;

  if (nextResult && nextResult[0]) {
    nextStory = nextResult[0];
  }
}
---

<Layout
  title={`${story.title} — Buku Cerita Anak #${story.storyNumber} Kisah Krayon`}
  description={story.synopsis || `Baca cerita bergambar anak "${story.title}" dengan ilustrasi krayon lembut pengantar tidur.`}
  image={`/${story.coverImage}`}
  type="book"
  canonicalUrl={new URL(getStoryUrl(story), Astro.url).href}
  isReader={true}
>
  {isLocked ? (
    <div style="max-width:48rem;margin:0 auto;display:flex;flex-direction:column;gap:1.5rem">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem">
        <div style="display:flex;align-items:center;gap:0.4rem">
          <a href="/perpustakaan" style="display:inline-flex;align-items:center;gap:0.4rem;font-size:0.85rem;font-weight:700;color:var(--muted);text-decoration:none;padding:0.4rem 0.8rem;background:#fff;border:1px solid var(--line);border-radius:999px">
            ← Perpustakaan
          </a>
          <button class="open-drawer-btn" style="display:inline-flex;align-items:center;gap:0.35rem;font-size:0.85rem;font-weight:700;color:var(--ink);background:#faf8f5;border:1px solid var(--line);border-radius:999px;padding:0.4rem 0.85rem;cursor:pointer;transition:all 0.15s ease">
            <span>📚</span> <span>40 Cerita</span>
          </button>
        </div>
        <span style="font-size:0.75rem;font-weight:800;color:#c85a32;background:#fbeee8;padding:0.3rem 0.75rem;border-radius:999px">
          Kisah #{story.storyNumber} · {story.categoryLabel}
        </span>
      </div>

      <div style="background:#fff;border:1px solid var(--line);border-radius:1.5rem;overflow:hidden;box-shadow:0 4px 12px rgba(36,34,32,0.04)">
        <div style="position:relative;aspect-ratio:4/3;background:#efe8dc;overflow:hidden">
          <img
            src={`/${story.coverImage}`}
            alt={story.title}
            style="width:100%;height:100%;object-fit:cover;display:block"
          />
          <div style="position:absolute;inset:0;background:linear-gradient(to top, rgba(36,34,32,0.85) 0%, rgba(36,34,32,0.3) 50%, rgba(36,34,32,0.15) 100%);display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;text-align:center;padding:1.5rem">
            <span style="font-size:3rem;margin-bottom:0.5rem">🔒</span>
            <span style="font-size:1.25rem;font-weight:900;letter-spacing:-0.01em">Cerita Ini Terkunci</span>
            <span style="font-size:0.85rem;opacity:0.9;max-width:26rem;margin-top:0.25rem">
              Hanya tersedia untuk pengguna yang telah memiliki akses cerita ini.
            </span>
          </div>
        </div>

        <div style="padding:1.5rem;display:flex;flex-direction:column;gap:1rem">
          <div>
            <h1 style="font-size:1.5rem;margin:0 0 0.35rem;letter-spacing:-0.02em">{story.title}</h1>
            {story.titleEn && <p style="margin:0 0 0.5rem;color:var(--muted);font-size:0.95rem;font-style:italic">{story.titleEn}</p>}
            <p style="margin:0;font-size:0.9rem;line-height:1.6;color:var(--muted)">{story.synopsis}</p>
          </div>

          <div style="display:flex;gap:0.75rem;flex-wrap:wrap;padding:0.75rem 1rem;background:#f7f3e9;border-radius:0.75rem;font-size:0.8rem">
            <span>🐾 <strong>Tokoh:</strong> {story.protagonist} {story.companion ? `& ${story.companion}` : ''}</span>
            {story.setting && <span>🏡 <strong>Latar:</strong> {story.setting}</span>}
            {story.ageGroup && <span>👶 <strong>Usia:</strong> {story.ageGroup}</span>}
          </div>

          <!-- Action based on user state -->
          <div style="margin-top:0.5rem;padding:1.25rem;background:#fff8eb;border:1px solid #fed7aa;border-radius:1rem;display:flex;flex-direction:column;gap:0.75rem">
            {!viewer.signedIn ? (
              <div style="display:flex;flex-direction:column;gap:0.75rem">
                <div>
                  <strong style="display:block;font-size:0.95rem;color:#7c2d12">Ingin membaca cerita ini?</strong>
                  <span style="font-size:0.8rem;color:#9a3412">Masuk atau daftarkan akun Anda terlebih dahulu untuk membuka akses.</span>
                </div>
                <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
                  <a href="/sign-up" style="background:#c85a32;color:#fff;text-decoration:none;font-weight:800;font-size:0.85rem;padding:0.6rem 1.25rem;border-radius:999px;display:inline-block">
                    Daftar Sekarang
                  </a>
                  <a href="/sign-in" style="background:#fff;border:1px solid #fed7aa;color:#7c2d12;text-decoration:none;font-weight:700;font-size:0.85rem;padding:0.6rem 1.25rem;border-radius:999px;display:inline-block">
                    Masuk ke Akun
                  </a>
                </div>
              </div>
            ) : viewer.storyCredits > 0 ? (
              <div style="display:flex;flex-direction:column;gap:0.75rem">
                <div>
                  <strong style="display:block;font-size:0.95rem;color:#1e3a8a">Kamu Punya {viewer.storyCredits} Kredit Cerita!</strong>
                  <span style="font-size:0.8rem;color:#1e40af">Gunakan 1 kredit untuk membuka cerita ini secara permanen.</span>
                </div>
                <form method="POST" action="/api/stories/claim">
                  <input type="hidden" name="storyId" value={story.id} />
                  <button type="submit" style="background:#2f5243;color:#fff;border:none;cursor:pointer;font-weight:800;font-size:0.85rem;padding:0.65rem 1.35rem;border-radius:999px">
                    Buka Cerita Ini (Gunakan 1 Kredit)
                  </button>
                </form>
              </div>
            ) : (
              <div style="display:flex;flex-direction:column;gap:0.75rem">
                <div>
                  <strong style="display:block;font-size:0.95rem;color:#7c2d12">Cerita ini belum masuk dalam paket kamu</strong>
                  <span style="font-size:0.8rem;color:#9a3412">Buka semua cerita mulai dari Rp 9.000 untuk 10 cerita atau Rp 29.000 untuk paket lengkap tanpa langganan.</span>
                </div>
                <div>
                  <a href="/akun" style="background:#c85a32;color:#fff;text-decoration:none;font-weight:800;font-size:0.85rem;padding:0.6rem 1.25rem;border-radius:999px;display:inline-block">
                    Lihat Pilihan Paket
                  </a>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  ) : (
    <div id="reader-root" class="reader-wrapper">
      <!-- Reader Top Bar (Ultra-clean, single-row on mobile) -->
      <div class="reader-top-bar">
        <div class="top-bar-controls-row">
          <div class="top-nav-group">
            <a href="/perpustakaan" class="top-btn btn-back" title="Kembali ke Perpustakaan">
              <span class="btn-back-icon">←</span>
              <span class="btn-back-text">Rak</span>
            </a>
            <button class="open-drawer-btn top-btn" title="Buka Navigasi 40 Cerita">
              <span>📚</span>
              <span>40 Cerita</span>
            </button>
          </div>

          <!-- Desktop Center Title (Shown ONLY on screens >= 900px) -->
          <div class="top-title-group desktop-only">
            <span class="top-title-meta">#{story.storyNumber} · {story.categoryLabel}</span>
            <h2 id="header-story-title" class="top-title-text">{story.title}</h2>
          </div>

          <div class="top-tools-group">
            <button id="lang-toggle-btn" class="top-tool-btn" title="Ganti Bahasa">
              ID
            </button>
            <button id="font-toggle-btn" class="top-tool-btn square" title="Perbesar Huruf">
              Aa
            </button>
            <button id="sleep-timer-btn" class="top-tool-btn square" title="Pengatur Waktu Tidur (15m/30m/Mati)" aria-label="Pengatur Waktu Tidur">
              <span id="sleep-timer-icon">⏱️</span>
              <span id="sleep-timer-text" style="display:none;font-size:0.68rem;font-weight:800;letter-spacing:-0.02em"></span>
            </button>
            <button id="dim-toggle-btn" class="top-tool-btn square" title="Mode Redup Pengantar Tidur (Layar Hangat)" aria-label="Mode Redup Pengantar Tidur">
              <span id="dim-btn-icon">🌙</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Reading Progress Bar -->
      <div class="reader-progress-track">
        <div id="progress-indicator" class="progress-bar-fill"></div>
      </div>

      <!-- Step Navigation Beads -->
      <div id="beads-container" class="beads-bar">
        <button class="step-bead active" data-step="0">Sampul</button>
        {pages.map((p) => (
          <button class="step-bead" data-step={p.number}>{p.number}</button>
        ))}
      </div>

      <!-- Story Spread Card -->
      <article id="story-spread-article" class="story-spread-card">
        <!-- 4:3 Art Canvas Frame with Left/Right paddles -->
        <div class="art-canvas-container">
          <img
            id="reader-image"
            src={`/${story.coverImage}`}
            alt={story.title}
            fetchpriority="high"
            decoding="async"
            class="reader-image-el is-loading"
            onload="this.classList.remove('is-loading'); document.getElementById('image-loader')?.classList.add('is-hidden');"
          />

          <!-- Instant SSR Crayon Paper Shimmer Skeleton -->
          <div id="image-loader" class="image-loader-overlay">
            <div class="shimmer-inner">
              <div class="crayon-spinner"></div>
              <span class="shimmer-text">Menyiapkan ilustrasi krayon...</span>
            </div>
          </div>

          <!-- Page Indicator Badge -->
          <span id="page-indicator-badge" class="page-indicator-badge">
            Sampul Buku
          </span>

          <!-- Left / Right Navigation Paddles -->
          <button id="paddle-prev" class="canvas-paddle paddle-left" title="Sebelumnya">
            ◀
          </button>
          <button id="paddle-next" class="canvas-paddle paddle-right" title="Selanjutnya">
            ▶
          </button>
        </div>

        <!-- RIGHT / BOTTOM CONTENT PANE -->
        <div class="reader-content-pane">
          <!-- Landscape-Only Mini Header -->
          <div class="landscape-mini-bar">
            <div style="display:flex;align-items:center;gap:0.35rem">
              <a href="/perpustakaan" class="top-btn" title="Kembali ke Perpustakaan">← Rak</a>
              <button class="open-drawer-btn top-btn" title="Buka Navigasi 40 Cerita">📚 40</button>
            </div>
            <div style="display:flex;align-items:center;gap:0.35rem">
              <button id="lang-toggle-btn-land" class="top-tool-btn" title="Ganti Bahasa">ID</button>
              <button id="dim-toggle-btn-land" class="top-tool-btn square" title="Mode Redup">🌙</button>
            </div>
          </div>

          <!-- IMMEDIATE Audio Narration Toolbar (Single Clean Sleek Row) -->
          {showAudioPlayer && (
            <div id="audio-container" class="audio-control-container">
              <div id="audio-toolbar" class="audio-toolbar-inner">
                <div class="audio-left-controls">
                  <button id="audio-play-btn" class="audio-play-btn" title="Putar atau jeda narasi dongeng">
                    <span id="audio-play-icon">▶</span>
                    <span id="audio-play-text">Putar Cerita</span>
                  </button>
                  <button id="audio-stop-btn" class="audio-stop-btn" title="Hentikan narasi">
                    ⏹
                  </button>
                </div>
                <button
                  id="auto-turn-toggle-btn"
                  type="button"
                  class="auto-turn-toggle is-active"
                  title="Balik halaman otomatis saat narasi audio selesai"
                  aria-pressed="true"
                >
                  <span class="toggle-icon" aria-hidden="true">🔄</span>
                  <span id="auto-turn-toggle-text">Balik Otomatis</span>
                </button>
              </div>
              <div id="audio-en-note" style="display:none;font-size:0.75rem;color:#78350f;background:#fff8eb;border:1px dashed #fed7aa;border-radius:0.75rem;padding:0.4rem 0.75rem;line-height:1.4">
                ℹ️ <em>Audio bahasa Inggris belum tersedia dan akan segera ditambahkan. Kamu tetap dapat memutar narasi bahasa Indonesia atau membaca teks dalam bahasa Inggris.</em>
              </div>
            </div>
          )}

          <!-- Narrative Text Area -->
          <div class="reader-narrative-box">
            <h3 id="reader-heading" class="reader-story-title">
              {story.title}
            </h3>

            <p id="reader-text" class="narrative-body">
              {story.synopsis}
            </p>

            <!-- Quote / Characters Pill -->
            <div id="reader-quote" class="reader-quote-pill">
              🐾 Tokoh: {story.protagonist} {story.companion ? `& ${story.companion}` : ''}
            </div>
          </div>

          <!-- Parent-Child Co-Reading Guidance Card -->
          <div id="reader-coreading" class="reader-coreading-card">
            💡 <strong>Tips Membaca:</strong> Baca dengan nada tenang dan hangat, ajak si kecil menunjuk detail pada ilustrasi krayon sebelum tidur.
          </div>

          <!-- Bottom Controls -->
          <div class="reader-bottom-nav">
            <button id="bottom-prev" class="bottom-nav-btn prev">
              ← Sebelumnya
            </button>
            <span id="bottom-page-label" class="bottom-nav-label">
              Sampul Buku
            </span>
            <button id="bottom-next" class="bottom-nav-btn next">
              Selanjutnya →
            </button>
          </div>
        </div>
      </article>

      <!-- Finish Celebration Modal -->
      <div id="finish-modal" style="display:none;position:fixed;inset:0;background:rgba(36,34,32,0.65);backdrop-filter:blur(4px);z-index:100;align-items:center;justify-content:center;padding:1.25rem">
        <div style="background:#fff;max-width:28rem;width:100%;border-radius:1.5rem;padding:2rem 1.5rem;text-align:center;display:flex;flex-direction:column;gap:1rem;box-shadow:0 20px 40px rgba(0,0,0,0.2)">
          <span style="font-size:3.5rem">🌙 ✨</span>
          <h2 style="font-size:1.5rem;margin:0;font-weight:900;letter-spacing:-0.02em;color:#242220">
            Cerita Selesai!
          </h2>
          <p style="margin:0;font-size:0.9rem;line-height:1.6;color:var(--muted)">
            Selamat tidur si kecil. Semoga mimpi indah bersama {story.protagonist} {story.companion ? `& ${story.companion}` : ''}!
          </p>
          <div style="display:flex;flex-direction:column;gap:0.5rem;margin-top:0.5rem">
            {nextStory && (
              <a href={getStoryUrl(nextStory)} style="background:#2f5243;color:#fff;text-decoration:none;font-weight:800;font-size:0.9rem;padding:0.75rem;border-radius:0.75rem;display:block">
                Cerita Selanjutnya: #{nextStory.storyNumber} {nextStory.title} →
              </a>
            )}
            <a
              id="modal-share-wa"
              href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`Alhamdulillah si kecil tidur nyenyak setelah membaca cerita "${story.title}" di Kisah Krayon 🖍️✨.\n\nBaca dongeng dan cerita bergambar pengantar tidur anak lainnya di:\nhttps://storybooks.bayuwibisana15.workers.dev/baca/${slugifyTitle(story.title)}`)}`}
              target="_blank"
              rel="noopener noreferrer"
              style="background:#25D366;color:#fff;text-decoration:none;font-weight:800;font-size:0.85rem;padding:0.65rem 1rem;border-radius:0.75rem;display:inline-flex;align-items:center;justify-content:center;gap:0.4rem;box-shadow:0 2px 6px rgba(37,211,102,0.3)"
            >
              <span>💬</span> <span>Bagikan ke WhatsApp</span>
            </a>
            <button id="modal-replay-btn" style="background:#faf8f5;border:1px solid var(--line);color:var(--ink);font-weight:700;font-size:0.85rem;padding:0.65rem;border-radius:0.75rem;cursor:pointer">
              🔄 Baca Ulang dari Sampul
            </button>
            <a href="/perpustakaan" style="color:var(--muted);text-decoration:none;font-weight:700;font-size:0.8rem;padding:0.5rem">
              ← Kembali ke Perpustakaan
            </a>
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- Floating Edge Tab for Left Margin -->
  <button id="floating-drawer-btn" class="floating-edge-tab" title="Buka Navigasi 40 Cerita (Navigasi Cepat)">
    <span style="font-size:1.05rem;margin-bottom:0.15rem">📚</span>
    <span>40 CERITA</span>
  </button>

  <!-- Drawer Backdrop Overlay -->
  <div id="drawer-backdrop" class="drawer-backdrop"></div>

  <!-- Off-Canvas Drawer Navigation -->
  <aside id="story-drawer" class="story-drawer" aria-label="Navigasi 40 Cerita">
    <!-- Drawer Header -->
    <div class="drawer-header">
      <div style="display:flex;align-items:center;gap:0.5rem">
        <span style="font-size:1.35rem">📚</span>
        <div>
          <h2 style="margin:0;font-size:0.95rem;font-weight:900;letter-spacing:-0.01em;color:var(--ink)">
            Koleksi Cerita
          </h2>
          <span style="font-size:0.72rem;color:var(--muted);font-weight:600">
            40 Kisah Pengantar Tidur
          </span>
        </div>
      </div>
      <button id="close-drawer-btn" class="drawer-close-btn" title="Tutup Navigasi (Esc)">
        ✕
      </button>
    </div>

    <!-- Search / Filter Input -->
    <div class="drawer-search-box">
      <span style="font-size:0.85rem;color:var(--muted)">🔍</span>
      <input
        id="drawer-search-input"
        type="text"
        placeholder="Cari nomor atau judul..."
        autocomplete="off"
      />
    </div>

    <!-- Stories List -->
    <div id="drawer-stories-list" class="drawer-list">
      {allStories.map((s) => {
        const isCurrent = s.id === story.id;
        const isFree = s.isFree;
        const isOwned = readable.has(s.id);

        return (
          <a
            href={getStoryUrl(s)}
            class={`drawer-story-item ${isCurrent ? 'is-current' : ''}`}
            data-number={s.storyNumber.toString()}
            data-title={`${s.title} ${s.titleEn || ''}`}
          >
            <div class="drawer-thumb-wrap">
              <img
                data-src={`/thumbnails/${s.coverImage}`}
                alt={s.title}
                loading="lazy"
                class="drawer-thumb"
              />
              <span class="drawer-num-badge">#{s.storyNumber}</span>
            </div>

            <div class="drawer-info">
              <div class="drawer-title-row">
                <h4 class="drawer-story-title">{s.title}</h4>
              </div>
              <div class="drawer-meta-row">
