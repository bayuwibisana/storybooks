# ---------------------------------------------------------------------------
# Neon (Postgres)
# DATABASE_URL  -> "Pooled connection" string. Used by the app at runtime.
# DATABASE_URL_UNPOOLED -> "Direct connection" string. Used by drizzle-kit
#   for migrations/push; pooled connections break DDL on Neon.
# Both come from Neon dashboard -> Connect. Append ?sslmode=require.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Clerk
# PUBLIC_ prefix = shipped to the browser. Secret key must never be.
# CLERK_WEBHOOK_SECRET -> from Clerk dashboard -> Webhooks -> your endpoint.
#   Needed only for the user-sync webhook; the JWT verification uses the secret key.
# ---------------------------------------------------------------------------
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Lynk
# One webhook URL per account. There is no documented signing scheme yet, so
# this stays optional until we see a real payload. If Lynk sends no signature,
# the endpoint falls back to "store first, verify later" + ref_id idempotency.
# ---------------------------------------------------------------------------
LYNK_WEBHOOK_SECRET=
LYNK_WEBHOOK_ALLOWED_IPS=

# ---------------------------------------------------------------------------
# Site
# PUBLIC_SITE_URL must match the Vercel domain exactly; it is baked into the
# Lynk "Platform = Other" link and into Clerk's allowed redirect origins.
# ---------------------------------------------------------------------------
PUBLIC_SITE_URL=http://localhost:4321
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Storage — story images are ~1.5MB each, ~400 files, so they cannot ship in the
# Vercel bundle. Cloudflare R2 holds them; the DB stores only the object key
# (e.g. "story12/page4.jpg"), never a public URL.
# Create an R2 API token (Object Read & Write) -> Access Key ID + Secret.
# ---------------------------------------------------------------------------
# Cloudflare R2 (story images)
# Bucket stays PRIVATE. No public r2.dev URL. Every image is served as a
# short-lived presigned GET from a server endpoint, so "locked" really means
# locked — the browser never receives a URL for a page it did not pay for.
# R2_ENDPOINT is derived from the account id; keep both if you use a custom domain.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kisah-krayon
R2_PUBLIC_URL=

# Audio Player Feature Flag (Set true to enable audio player in UI, false to hide)
PUBLIC_ENABLE_AUDIO=false
